APP_HOST=127.0.0.1
APP_PORT=8000
APP_DEV=false

WHISPER_MODEL=base
WHISPER_LANGUAGE=en
WHISPER_TASK=transcribe
WHISPER_FP16=false
WHISPER_AUDIO_SUFFIX=.wav

# embeddings + llm
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
OPENAI_LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=

# chroma store
CHROMA_COLLECTION=faqs
CHROMA_DB_PATH=chroma_db

# elevenlabs tts
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_monolingual_v1
ELEVENLABS_API_KEY=

# pgvector store (used when PgVectorStore adapter is selected)
PGVECTOR_CONN=postgresql://user:pass@localhost:5432/voicechat
PGVECTOR_TABLE=vectors
PGVECTOR_DIMENSIONS=384
