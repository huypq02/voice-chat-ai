APP_HOST=127.0.0.1
APP_PORT=8000
APP_DEV=false

WHISPER_MODEL=base
WHISPER_LANGUAGE=en
WHISPER_TASK=transcribe
WHISPER_FP16=false
WHISPER_AUDIO_SUFFIX=.wav

# embeddings + llm
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
OPENAI_LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=

# gemini llm + embedder + tts (optional — use GeminiLLM / GeminiEmbedder / GeminiTTS adapters)
GEMINI_LLM_MODEL=gemini-1.5-flash
GEMINI_EMBEDDING_MODEL=models/text-embedding-004
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TTS_VOICE=Kore
GEMINI_API_KEY=

# chroma store
CHROMA_COLLECTION=faqs
CHROMA_DB_PATH=chroma_db

# elevenlabs tts
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_monolingual_v1
ELEVENLABS_API_KEY=

# pgvector store (used when PgVectorStore adapter is selected)
PGVECTOR_CONN=postgresql://user:pass@localhost:5432/voicechat
PGVECTOR_TABLE=vectors
PGVECTOR_DIMENSIONS=384

# realtime STT — Deepgram (ws /ws/transcribe?provider=deepgram)
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-2
DEEPGRAM_LANGUAGE=en-US
DEEPGRAM_SAMPLE_RATE=16000
DEEPGRAM_CHANNELS=1
DEEPGRAM_ENCODING=linear16

# realtime STT — AssemblyAI (ws /ws/transcribe?provider=assemblyai)
ASSEMBLYAI_API_KEY=
ASSEMBLYAI_SAMPLE_RATE=16000
